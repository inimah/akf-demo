# Salin menjadi .env lalu isi dengan path milik Anda:   cp .env.example .env && chmod 600 .env
# .env TIDAK di-commit (ada di .gitignore). Gunakan path absolut (tanpa ~ atau $HOME).
# Variabel yang sudah di-export di shell akan diutamakan daripada isi file ini.

# Folder model lokal (hasil unduh_model.sh). Wajib untuk demo GPU.
MODEL_DIR=/path/ke/scratch/anda/models

# Environment Python untuk job GPU. Pilih SALAH SATU:
#
# (A) Python native + venv, TANPA miniforge/conda (disarankan untuk pengguna baru):
#       python3 -m venv /path/ke/venv-akf-demo
#       /path/ke/venv-akf-demo/bin/pip install --upgrade pip
#       /path/ke/venv-akf-demo/bin/pip install -r requirements.txt
VENV=/path/ke/venv-akf-demo
#
# (B) Miniforge/conda (kosongkan/komentari VENV di atas):
# CONDA_ROOT=/path/ke/miniforge3
# CONDA_ENV=vllm_env
#
# Bila VENV dan CONDA_ROOT sama-sama kosong, job memakai python3 bawaan sistem.

# Opsional (default sudah sesuai cluster AKF):
# NPU_MODEL_DIR=/apps/AI/LLM/models/NPU/furiosa-ai
# FURIOSA_VENV=/apps/AI/venv_furiosa/furiosa_llm
